# Copy to .env and fill in your own values. Never commit real keys.

# --- Ports ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
BIND_HOST=127.0.0.1

# --- LLM (OpenAI-compatible) ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=
OPENAI_MODEL=

# --- Database ---
# SQLite (default, zero-config local):
DATABASE_URL=sqlite:///./app.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cognitive_ip_db
